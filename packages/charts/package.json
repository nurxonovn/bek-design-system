{
  "name": "@bek-ui/charts",
  "version": "1.0.0-beta.0",
  "description": "BEK Design System charts and diagrams — 61 SVG React components on @bek-ui/tokens",
  "license": "MIT",
  "author": "Nurbek Nurxonov (https://github.com/nurxonovn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurxonovn/bek-design-system.git",
    "directory": "packages/charts"
  },
  "homepage": "https://nurxonovn.github.io/bek-design-system/",
  "bugs": {
    "url": "https://github.com/nurxonovn/bek-design-system/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "figma",
    "react",
    "uzbekistan",
    "bek",
    "charts",
    "dataviz",
    "d3",
    "bek-ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "check:figma": "node ../react/scripts/check-figma.mjs --root=."
  },
  "dependencies": {
    "@bek-ui/react": "workspace:*",
    "@bek-ui/tokens": "workspace:*",
    "d3-array": "3.2.4",
    "d3-chord": "3.0.1",
    "d3-force": "3.0.0",
    "d3-hierarchy": "3.1.2",
    "d3-sankey": "0.12.3",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/d3-array": "3.2.1",
    "@types/d3-chord": "3.0.6",
    "@types/d3-force": "3.0.10",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-sankey": "0.12.4",
    "@types/d3-scale": "4.0.8",
    "@types/d3-shape": "3.1.6",
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
