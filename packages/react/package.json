{
  "name": "@bek-ui/react",
  "version": "1.0.0-beta.0",
  "description": "BEK Design System — 58 React components on design tokens, Light/Dark, RTL, accessible",
  "license": "MIT",
  "author": "Nurbek Nurxonov (https://github.com/nurxonovn)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nurxonovn/bek-design-system.git",
    "directory": "packages/react"
  },
  "homepage": "https://nurxonovn.github.io/bek-design-system/",
  "bugs": {
    "url": "https://github.com/nurxonovn/bek-design-system/issues"
  },
  "keywords": [
    "design-system",
    "design-tokens",
    "figma",
    "react",
    "uzbekistan",
    "bek",
    "bek-ui"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "check:figma": "node scripts/check-figma.mjs"
  },
  "dependencies": {
    "@bek-ui/tokens": "workspace:*",
    "clsx": "2.1.1",
    "page-mascot": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
